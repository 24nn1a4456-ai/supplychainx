# Supply Chain X Backend — Environment Variables
# Copy this to .env for local development (never commit .env)

PROJECT_NAME="Supply Chain X Autonomous API"
API_V1_STR=/api
PORT=8000
HOST=0.0.0.0

# SQLite (default, local dev)
DATABASE_URL=sqlite:///./supply_chain.db

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# Optional: OpenWeather API key for live weather disruption data
OPENWEATHER_API_KEY=your_openweather_api_key_here
